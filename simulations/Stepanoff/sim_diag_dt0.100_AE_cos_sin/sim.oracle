// $qucf sim ./ 
CONSTANTS
	// --- nx = 6 ----------------------------------------------------------------
	// --- For spatial and time grids ---
	Nt 	10
	nx 	6
	nxD 	12
	// --- For initialization subcircuit ---
	alpha_init_0 	0.000000000000e+00
	alpha_init_1 	1.595729601823e+00
	// --- For QSP BE sin oracle ---
	alpha_qsp_0 	0.000000000000e+00
	alpha_qsp_1 	3.191459203647e+00
	// --- For sin function ---
	Nx_half_m_one 	31
	alpha_sin_0 	3.191459203647e+00
	alpha_sin_1 	1.595729601823e+00

	// --- for AA of initial conditions ----------------------------------------------------------------
	N_AA_init   2   // for kappa = 1, nx = 8

	// --- For AE ---
	ny   4
END_CONSTANTS


OPTIONS
    sel_compute_output zero-ancillae
	sel_print_output   none  // none, all, zero-ancillae
	flag_tex     0
	tex_CL  10
	flag_matrix 0
	flag_stop_gates    1 
	flag_repeat_insert 0  // !!!
END_OPTIONS


// ---------------------------------------------------------------
CIRCUITS_DECLARATION  
	// --- initialization ---
	U_BE_init_theta_phi  3            a 1 1 rb <nx> 0 re <nx> 0
	U_BE_init_phi        2            a 1 1 r  <nx> 0 
	U_init               3            a 3 1 rb <nx> 0 re <nx> 0
	PREP_init            3 aAA 1 1 a_be 3 1 r <nxD> 0 
	RA_init              3 aAA 1 1 a_be 3 1 r <nxD> 0

	// --- Fourier transformation ---
	U_FFT_theta   2 rb <nx> 0 re <nx> 0
	U_FFT_phi     2 rb <nx> 0 re <nx> 0

	// --- Hamiltonian simulations ---
	U_be_sin_M1        2 a 2 1 r <nx> 0
	U_be_sin_M2        2 a 2 1 r <nx> 0
	U_be_sin_M1_minus  2 a 2 1 r <nx> 0
	U_be_sin_M2_minus  2 a 2 1 r <nx> 0
	U_diag_M1          4 a_qsp 2 1 a_be 2 1 rb <nx> 0 re <nx> 0
	U_diag_M2          4 a_qsp 2 1 a_be 2 1 rb <nx> 0 re <nx> 0

	// --- Simulation: one time step ---
	U_sim_dt     4 a_qsp 2 1 a_be 2 1 rb <nx> 0 re <nx> 0 

	// --- Preparation circuit ---
	U_PREP  5          a_meas 2 1 a_init 4 1 a 4 1 rb <nx> 0 re <nx> 0

	// --- AA circuit for measurement ---
	U_AA    4          a_meas 2 1 a_init 4 1 a 4 1 r <nxD> 0

	// --- Amplitude Estimation circuit (main circuit) ---
	U_AE    5 y <ny> 1 a_meas 2 1 a_init 4 1 a 4 1 r <nxD> 0
END_CIRCUITS_DECLARATION


//  ---------------------------------------------------------------
MAIN_CIRCUIT   U_AE    
	INPUT_STATE  0 
	compute_prob    1   y -1
END_MAIN_CIRCUIT


// ---------------------------------------------------------------
// --- Initialization ---
CIRCUIT_STRUCTURE   U_BE_init_theta_phi
	gate cos a 1 <alpha_init_0> <alpha_init_1> re -1 end_gate
	gate cos a 1 <alpha_init_0> <alpha_init_1> rb -1 end_gate
	gate X a 1 end_gate
END_CIRCUIT_STRUCTURE


CIRCUIT_STRUCTURE   U_BE_init_phi
	gate sin a 1 <alpha_init_0> <alpha_init_1> r -1 end_gate
END_CIRCUIT_STRUCTURE


CIRCUIT_STRUCTURE  U_init
	gate H 2 rb -1 re -1 end_gate
	gate QSVT init a[1]  U_BE_init_theta_phi 3 a[0] rb -1 re -1 end_gate
	gate QSVT init a[2]  U_BE_init_phi       2 a[0] rb -1       end_gate  
END_CIRCUIT_STRUCTURE


CIRCUIT_STRUCTURE   PREP_init
	circuit U_init 2 r -1 a_be -1  end_circuit
	gate X aAA 1 ocontrol 1 a_be -1  end_gate
END_CIRCUIT_STRUCTURE


CIRCUIT_STRUCTURE RA_init
	// sign change of the good state (state |1>)
	gate  Z aAA 1 end_gate     
	//
	icircuit PREP_init 3 r -1 a_be -1 aAA 1 end_circuit
	// sign change of the initial state
	gate X aAA 1 ocontrol 2 r -1 a_be -1  end_gate
	gate Z aAA 1 ocontrol 2 r -1 a_be -1  end_gate
	gate X aAA 1 ocontrol 2 r -1 a_be -1  end_gate
	// 
	circuit PREP_init 3 r -1 a_be -1 aAA 1 end_circuit
END_CIRCUIT_STRUCTURE


// ---------------------------------------------------------------
// --- Fourier transformation ---
CIRCUIT_STRUCTURE  U_FFT_theta
	igate Fourier re -1 end_gate  // using inverse gate to keep the sign in FFT consistent with classical comp.
	gate X re[-1] end_gate // shift Fourier spectrum appropriately to the order of elements in the propagator 
			// (corresponds to fftshift in python)
END_CIRCUIT_STRUCTURE


CIRCUIT_STRUCTURE  U_FFT_phi
	igate Fourier rb -1 end_gate // using inverse gate to keep the sign in FFT consistent with classical comp.
	gate X rb[-1] end_gate // shift Fourier spectrum appropriately to the order of elements in the propagator
			// (corresponds to fftshift in python)
END_CIRCUIT_STRUCTURE



// ---------------------------------------------------------------
// --- BE diagonal matrix (LCU + cos-operator) ---
CIRCUIT_STRUCTURE   U_be_sin_M1
	gate H a[1] end_gate
	gate cos a[0] <alpha_qsp_0> <alpha_qsp_1> r -1 control a[1] end_gate
	gate H a[1] end_gate
	gate X a[1] end_gate  // to choose (1 - cos)
END_CIRCUIT_STRUCTURE


CIRCUIT_STRUCTURE   U_be_sin_M1_minus
	circuit U_be_sin_M1 -1 end_circuit
	gate Rz a[0] <M_2PI> end_gate
END_CIRCUIT_STRUCTURE


CIRCUIT_STRUCTURE   U_be_sin_M2
	gate H a[1] end_gate
	gate cos a[0] <alpha_qsp_0> <alpha_qsp_1> r -1 ocontrol a[1] end_gate
	gate H a[1] end_gate
	gate X a[1] end_gate  // to choose -(1 - cos)
END_CIRCUIT_STRUCTURE


CIRCUIT_STRUCTURE   U_be_sin_M2_minus
	circuit U_be_sin_M2 -1 end_circuit
	gate Rz a[0] <M_2PI> end_gate 
END_CIRCUIT_STRUCTURE


// ---------------------------------------------------------------------
// --- Hamiltonian evolutions ---
// ---------------------------------------------------------------------
CIRCUIT_STRUCTURE  U_diag_M1  
	// --- positive index * frequency ---
	gate QSVT qsp_M1_0   a_qsp -1  U_be_sin_M1 2 a_be -1 rb -1 control re[0] end_gate
	gate QSVT qsp_M1_1   a_qsp -1  U_be_sin_M1 2 a_be -1 rb -1 control re[1] end_gate
	gate QSVT qsp_M1_2   a_qsp -1  U_be_sin_M1 2 a_be -1 rb -1 control re[2] end_gate
	gate QSVT qsp_M1_3   a_qsp -1  U_be_sin_M1 2 a_be -1 rb -1 control re[3] end_gate
	gate QSVT qsp_M1_4   a_qsp -1  U_be_sin_M1 2 a_be -1 rb -1 control re[4] end_gate
	gate QSVT qsp_M1_5   a_qsp -1  U_be_sin_M1 2 a_be -1 rb -1 control re[5] end_gate // up to (including this gate) for nx = 6
	// gate QSVT qsp_M1_6   a_qsp -1  U_be_sin_M1 2 a_be -1 rb -1 control re[6] end_gate
	// gate QSVT qsp_M1_7   a_qsp -1  U_be_sin_M1 2 a_be -1 rb -1 control re[7] end_gate
	// gate QSVT qsp_M1_8   a_qsp -1  U_be_sin_M1 2 a_be -1 rb -1 control re[8] end_gate
	// gate QSVT qsp_M1_9   a_qsp -1  U_be_sin_M1 2 a_be -1 rb -1 control re[9] end_gate

	// --- shift by N_half: (!) must apply the QSVT controlled by the high-priority qubit ---
	gate QSVT qsp_M1_5   a_qsp -1  U_be_sin_M1_minus 2 a_be -1 rb -1  end_gate 
END_CIRCUIT_STRUCTURE


CIRCUIT_STRUCTURE  U_diag_M2  
	gate QSVT qsp_M2_0   a_qsp -1  U_be_sin_M2 2 a_be -1 re -1 control rb[0] end_gate
	gate QSVT qsp_M2_1   a_qsp -1  U_be_sin_M2 2 a_be -1 re -1 control rb[1] end_gate
	gate QSVT qsp_M2_2   a_qsp -1  U_be_sin_M2 2 a_be -1 re -1 control rb[2] end_gate
	gate QSVT qsp_M2_3   a_qsp -1  U_be_sin_M2 2 a_be -1 re -1 control rb[3] end_gate
	gate QSVT qsp_M2_4   a_qsp -1  U_be_sin_M2 2 a_be -1 re -1 control rb[4] end_gate
	gate QSVT qsp_M2_5   a_qsp -1  U_be_sin_M2 2 a_be -1 re -1 control rb[5] end_gate // up to (including this gate) for nx = 6
	// gate QSVT qsp_M2_6   a_qsp -1  U_be_sin_M2 2 a_be -1 re -1 control rb[6] end_gate
	// gate QSVT qsp_M2_7   a_qsp -1  U_be_sin_M2 2 a_be -1 re -1 control rb[7] end_gate
	// gate QSVT qsp_M2_8   a_qsp -1  U_be_sin_M2 2 a_be -1 re -1 control rb[8] end_gate
	// gate QSVT qsp_M2_9   a_qsp -1  U_be_sin_M2 2 a_be -1 re -1 control rb[9] end_gate

	// --- shift by N_half: (!) must apply the QSVT controlled by the high-priority qubit ---
	gate QSVT qsp_M2_5   a_qsp -1  U_be_sin_M2_minus 2 a_be -1 re -1  end_gate 
END_CIRCUIT_STRUCTURE


// ---------------------------------------------------------------
// --- Simulation: one time step ---
// ---------------------------------------------------------------
CIRCUIT_STRUCTURE U_sim_dt
	// --- Simulation in Fourier space over theta ---
	circuit  U_FFT_theta -1 end_circuit
	circuit  U_diag_M1   -1 end_circuit
	icircuit U_FFT_theta -1 end_circuit

	// --- Simulation in Fourier space over phi ---
	circuit  U_FFT_phi -1 end_circuit
	circuit  U_diag_M2 -1 end_circuit
    icircuit U_FFT_phi -1 end_circuit
END_CIRCUIT_STRUCTURE


// ---------------------------------------------------------------
// --- Hamiltonian simulation ---
// ---------------------------------------------------------------
CIRCUIT_STRUCTURE   U_PREP
	// --- Initialization (with AA) ---
	circuit PREP_init   3 re -1 rb -1 a_init -1 end_circuit
	gate repeat RA_init 3 re -1 rb -1 a_init -1 <N_AA_init> end_gate
	gate X a_init[-1] end_gate  // to entangle the result with the zero state of the ancilla

	// --- Simulation: Nt time steps ---
	gate repeat U_sim_dt 3 re -1 rb -1 a -1 <Nt> ocontrol a_init -1 end_gate

	// --- Form the observable: sin along theta and cos along phi (entangled with a_meas = 1) ---
	gate sin a_meas 1 <alpha_sin_0> <alpha_sin_1> re <Nx_half_m_one> ocontrol 2 a_init -1 a -1 control re[-1] end_gate
	gate X   a_meas 1                                                ocontrol 2 a_init -1 a -1                end_gate 

	gate cos a_meas 2 <alpha_qsp_0> <alpha_qsp_1> rb -1 ocontrol 2 a_init -1 a -1 end_gate
	gate X   a_meas 2                                   ocontrol 2 a_init -1 a -1 end_gate 
END_CIRCUIT_STRUCTURE


// ---------------------------------------------------------------
// --- AA of the Hamiltonian simulation ---
// ---------------------------------------------------------------
CIRCUIT_STRUCTURE   U_AA
	// sign change of the "good" state (state |1>_{a_meas})
	gate Z a_meas 2 control a_meas 1 end_gate 
	//
	icircuit U_PREP 4 r -1 a -1 a_init -1 a_meas -1 end_circuit
	// sign change of the "bad" state (zero state):
	gate X a_meas 2 ocontrol 4 r -1 a -1 a_init -1 a_meas 1 end_gate
	gate Z a_meas 2 ocontrol 4 r -1 a -1 a_init -1 a_meas 1 end_gate
	gate X a_meas 2 ocontrol 4 r -1 a -1 a_init -1 a_meas 1 end_gate
	//
	circuit U_PREP 4 r -1 a -1 a_init -1 a_meas -1 end_circuit
END_CIRCUIT_STRUCTURE


// ---------------------------------------------------------------
// --- AE of the observable ---
// ---------------------------------------------------------------
CIRCUIT_STRUCTURE  U_AE
	gate  PE  4 r -1 a -1 a_init -1 a_meas -1  U_AA  U_PREP  y -1 end_gate
END_CIRCUIT_STRUCTURE



