// $qucf diag_neg ./ 
CONSTANTS
	// // --- n_half = 1 --------------------------------------------------------------
	// // --- Number of qubits ---
	// nx   2
	// nxD  4
	// N_half 2
	// // --- For QSP BE sin oracle ---
	// alpha_qsp_0 	0.000000000000e+00
	// alpha_qsp_1 	4.188790204786e+00

	// // --- n_half = 2 --------------------------------------------------------------
	// // --- Number of qubits ---
	// nx   3
	// nxD  6
	// N_half 4
	// // --- For QSP BE sin oracle ---
	// alpha_qsp_0 	0.000000000000e+00
	// alpha_qsp_1 	3.590391604103e+00


	// --- n_half = 3 --------------------------------------------------------------
	// --- Number of qubits ---
	nx   4
	nxD  8
	N_half 8
	// --- For QSP BE sin oracle ---
	alpha_qsp_0 	0.000000000000e+00
	alpha_qsp_1 	3.351032163829e+00
END_CONSTANTS


OPTIONS
    sel_compute_output none
	sel_print_output   none  // none, all, zero-ancillae
	flag_tex     0
	tex_CL  10
	flag_matrix 1
END_OPTIONS


// ---------------------------------------------------------------
CIRCUITS_DECLARATION  
	U_be_unit        2 a 2 1 r <nx> 0
	U_be_unit_minus  2 a 2 1 r <nx> 0
	U_diag_M0        4 a_qsp 2 1 a_be 2 1 rb <nx> 0 re <nx> 0

	U_be_sin_M1          2 a 2 1 r <nx> 0
	U_be_sin_M2          2 a 2 1 r <nx> 0
	U_be_sin_M1_minus    2 a 2 1 r <nx> 0
	U_be_sin_M2_minus    2 a 2 1 r <nx> 0
	U_diag_M1            4 a_qsp 2 1 a_be 2 1 rb <nx> 0 re <nx> 0
	U_diag_M2            4 a_qsp 2 1 a_be 2 1 rb <nx> 0 re <nx> 0

	U              2 a 4 1 r <nxD> 0
END_CIRCUITS_DECLARATION


// ---------------------------------------------------------------
MAIN_CIRCUIT   U       
	INPUT_STATE  0 
END_MAIN_CIRCUIT


// ---------------------------------------------------------------
// --- BE diagonal matrix ---
CIRCUIT_STRUCTURE   U_be_unit
	// unit matrix
END_CIRCUIT_STRUCTURE


CIRCUIT_STRUCTURE   U_be_unit_minus
	circuit U_be_unit -1 end_circuit
	gate Rz a[0] <M_2PI> end_gate
END_CIRCUIT_STRUCTURE


CIRCUIT_STRUCTURE   U_be_sin_M1
	gate H a[1] end_gate
	gate cos a[0] <alpha_qsp_0> <alpha_qsp_1> r -1 control a[1] end_gate
	gate H a[1] end_gate
	gate X a[1] end_gate  // to choose (1 - cos)
END_CIRCUIT_STRUCTURE


CIRCUIT_STRUCTURE   U_be_sin_M1_minus
	circuit U_be_sin_M1 -1 end_circuit
	gate Rz a[0] <M_2PI> end_gate
END_CIRCUIT_STRUCTURE


CIRCUIT_STRUCTURE   U_be_sin_M2
	gate H a[1] end_gate
	gate cos a[0] <alpha_qsp_0> <alpha_qsp_1> r -1 ocontrol a[1] end_gate
	gate H a[1] end_gate
	gate X a[1] end_gate  // to choose -(1 - cos)
END_CIRCUIT_STRUCTURE


CIRCUIT_STRUCTURE   U_be_sin_M2_minus
	circuit U_be_sin_M2 -1 end_circuit
	gate Rz a[0] <M_2PI> end_gate 
END_CIRCUIT_STRUCTURE



// ---------------------------------------------------------------------
// CIRCUIT_STRUCTURE  U_diag_M0 
// 	// --- positive index * frequency ---
// 	gate QSVT qsp_M1_0   a_qsp -1  U_be_unit 2 a_be -1 rb -1  control re[0]  end_gate
// 	gate QSVT qsp_M1_1   a_qsp -1  U_be_unit 2 a_be -1 rb -1  control re[1]  end_gate
// 	gate QSVT qsp_M1_2   a_qsp -1  U_be_unit 2 a_be -1 rb -1  control re[2]  end_gate
// 	gate QSVT qsp_M1_3   a_qsp -1  U_be_unit 2 a_be -1 rb -1  control re[3]  end_gate

// 	// --- shift by N_half: must apply the QSVT used by the high-priority qubit ---
// 	gate QSVT qsp_M1_3   a_qsp -1  U_be_unit_minus 2 a_be -1 rb -1  end_gate 
// END_CIRCUIT_STRUCTURE



// --- Attention: target register ---
CIRCUIT_STRUCTURE  U_diag_M1  
	// --- positive index * frequency ---
	gate QSVT qsp_M1_0   a_qsp -1  U_be_sin_M1 2 a_be -1 rb -1 control re[0] end_gate
	gate QSVT qsp_M1_1   a_qsp -1  U_be_sin_M1 2 a_be -1 rb -1 control re[1] end_gate
	gate QSVT qsp_M1_2   a_qsp -1  U_be_sin_M1 2 a_be -1 rb -1 control re[2] end_gate
	gate QSVT qsp_M1_3   a_qsp -1  U_be_sin_M1 2 a_be -1 rb -1 control re[3] end_gate

	// --- shift by N_half: (!) must apply the QSVT used by the high-priority qubit ---
	gate QSVT qsp_M1_3   a_qsp -1  U_be_sin_M1_minus 2 a_be -1 rb -1  end_gate 
END_CIRCUIT_STRUCTURE



CIRCUIT_STRUCTURE  U_diag_M2  
	gate QSVT qsp_M2_0   a_qsp -1  U_be_sin_M2 2 a_be -1 rb -1 control re[0] end_gate
	gate QSVT qsp_M2_1   a_qsp -1  U_be_sin_M2 2 a_be -1 rb -1 control re[1] end_gate
	gate QSVT qsp_M2_2   a_qsp -1  U_be_sin_M2 2 a_be -1 rb -1 control re[2] end_gate
	gate QSVT qsp_M2_3   a_qsp -1  U_be_sin_M2 2 a_be -1 rb -1 control re[3] end_gate

	// --- shift by N_half: (!) must apply the QSVT used by the high-priority qubit ---
	gate QSVT qsp_M2_3   a_qsp -1  U_be_sin_M2_minus 2 a_be -1 rb -1  end_gate 
END_CIRCUIT_STRUCTURE



// ---------------------------------------------------------------
CIRCUIT_STRUCTURE   U
	// circuit U_diag_M0 -1 end_circuit
	circuit U_diag_M1 -1 end_circuit
	// circuit U_diag_M2 -1 end_circuit
END_CIRCUIT_STRUCTURE
















